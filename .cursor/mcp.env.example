# Глобальная конфигурация MCP для всех проектов на этом компьютере.
# Файлы:
#   ~/.cursor/mcp.json       — серверы MCP
#   ~/.cursor/mcp.env        — секреты (не коммитить)
#   ~/.cursor/mcp.env.example — шаблон секретов
#
# Скопируйте шаблон и заполните значения:
#   cp ~/.cursor/mcp.env.example ~/.cursor/mcp.env
#
# GitHub: https://github.com/settings/tokens (scopes: repo, read:org)
CURSOR_GITHUB_TOKEN=

# Postman: https://web.postman.co/settings/me/api-keys
POSTMAN_API_KEY=
